{
  "name": "tax-assistant-coursework",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "build": "npm run build -w server && npm run build -w client",
    "test": "npm test -w server",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build:vercel": "npm run build && tsc --noEmit -p tsconfig.vercel.json"
  },
  "devDependencies": {
    "prettier": "^3.10.1"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@vercel/functions": "^3.11.3"
  }
}
